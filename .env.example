CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_token

# Optional: default Workers AI embedding model + vector size for
# scripts/seed-taxonomy.ts and scripts/classify-synthetic-data.ts.
# Both scripts' --model=/--dimensions= flags override this per run.
# Falls back to @cf/google/embeddinggemma-300m / 768 if unset.
# EMBEDDING_MODEL=@cf/google/embeddinggemma-300m
# EMBEDDING_DIMENSIONS=768

# Required for scripts/generate-synthetic-data.ts — get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
